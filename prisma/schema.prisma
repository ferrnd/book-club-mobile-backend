generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Projeto {
    id              Int      @id @default(autoincrement())
    nome_pt         String
    nome_en         String
    apresentacao_pt String   @db.Text
    apresentacao_en String   @db.Text
    objetivo_pt     String   @db.Text
    objetivo_en     String   @db.Text
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@map("projeto")
}

model Livro {
  id                            Int      @id @default(autoincrement())
  titulo                        String
  capa                          String
  autor                         String
  detalhesAutor                 String   @db.Text
  detalhesAutor_en              String   @db.Text
  anoPublicacao                 Int
  genero                        String
  genero_en                     String
  resumo                        String   @db.Text
  resumo_en                     String   @db.Text
  contexto                      String   @db.Text
  contexto_en                   String   @db.Text
  estiloEscrita                 String   @db.Text
  estiloEscrita_en              String   @db.Text
  enredo                        String   @db.Text
  enredo_en                     String   @db.Text
  verossimilhanca               String   @db.Text
  verossimilhanca_en            String   @db.Text
  personagens                   String[]
  caracteristicasLiterarias     String   @db.Text
  caracteristicasLiterarias_en  String   @db.Text
  conclusao                     String   @db.Text
  conclusao_en                  String   @db.Text
}

model Autor {
    id                Int      @id @default(autoincrement())
    nome              String
    fotoUrl           String?
    nascimento        String
    nacionalidade     String
    biografia_pt      String   @db.Text
    biografia_en      String   @db.Text
    estilo_escrita_pt String   @db.Text
    estilo_escrita_en String   @db.Text
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model Conto {
    id          Int          @id @default(autoincrement())
    titulo_pt   String
    titulo_en   String
    resumo_pt   String       @db.Text
    resumo_en   String       @db.Text
    analise_pt  String       @db.Text
    analise_en  String       @db.Text
    personagens Personagem[]
    citacoes    Citacao[]
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    @@map("conto")
}

model Personagem {
    id                 Int      @id @default(autoincrement())
    nome               String
    fotoUrl            String?
    caracteristicas_pt String   @db.Text
    caracteristicas_en String   @db.Text
    descricao_pt       String   @db.Text
    descricao_en       String   @db.Text
    conto              Conto    @relation(fields: [contoId], references: [id])
    contoId            Int
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@map("personagem")
}

model Citacao {
    id          Int      @id @default(autoincrement())
    texto_pt    String   @db.Text
    texto_en    String   @db.Text
    conto       Conto    @relation(fields: [contoId], references: [id])
    contoId     Int
    personagem  String
    explicacao_pt String   @db.Text
    explicacao_en String   @db.Text
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("citacao")
}

model Quiz {
    id            Int      @id @default(autoincrement())
    pergunta_pt   String   @db.Text
    pergunta_en   String   @db.Text
    opcaoA_pt     String   @db.Text
    opcaoA_en     String   @db.Text
    opcaoB_pt     String   @db.Text
    opcaoB_en     String   @db.Text
    opcaoC_pt     String   @db.Text
    opcaoC_en     String   @db.Text
    opcaoD_pt     String   @db.Text
    opcaoD_en     String   @db.Text
    opcaoE_pt     String   @db.Text
    opcaoE_en     String   @db.Text
    resposta      String
    explicacao_pt String   @db.Text
    explicacao_en String   @db.Text
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@map("quiz")
}

model VideoAula {
    id           Int      @id @default(autoincrement())
    titulo_pt    String
    titulo_en    String
    descricao_pt String?  @db.Text
    descricao_en String?  @db.Text
    url          String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@map("videoaula")
}

model Dica {
    id          Int      @id @default(autoincrement())
    tipo_pt     String
    tipo_en     String
    conteudo_pt String   @db.Text
    conteudo_en String   @db.Text
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("dica")
}

model Membro {
    id        Int      @id @default(autoincrement())
    nome      String
    curso_pt  String
    curso_en  String
    fotoUrl   String?
    github    String?
    linkedin  String?
    email     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("membro")
}

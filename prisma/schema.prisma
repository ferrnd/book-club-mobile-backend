generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Livro {
    id                   Int         @id @default(autoincrement())
    titulo               String
    capa                 String
    autor                String
    anoPublicacao        Int
    genero_pt            String      @db.Text
    genero_en            String      @db.Text
    resumo_pt            String      @db.Text
    resumo_en            String      @db.Text
    personagens         String[]     
    contextoHistorico_pt String      @db.Text
    contextoHistorico_en String      @db.Text
    analise_pt           String      @db.Text
    analise_en           String      @db.Text
    createdAt            DateTime    @default(now())
    updatedAt            DateTime    @updatedAt

    @@map("livro")
}

model Conto {
    id          Int         @id @default(autoincrement())
    titulo_pt   String
    titulo_en   String
    resumo_pt   String      @db.Text
    resumo_en   String      @db.Text
    analise_pt  String      @db.Text
    analise_en  String      @db.Text
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    @@map("conto")
}

model Personagem {
    id           Int         @id @default(autoincrement())
    nome         String
    fotoUrl      String?
    descricao_pt String      @db.Text
    descricao_en String      @db.Text
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    @@map("personagem")
}

model Citacao {
    id         Int         @id @default(autoincrement())
    texto_pt   String      @db.Text
    texto_en   String      @db.Text
    personagem String
    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt

    @@map("citacao")
}

model Quiz {
    id               Int         @id @default(autoincrement())
    pergunta_pt      String      @db.Text
    pergunta_en      String      @db.Text
    opcoes_pt        String[]    
    opcoes_en        String[]    
    respostaCorreta  Int
    explicacao_pt    String      @db.Text
    explicacao_en    String      @db.Text
    createdAt        DateTime    @default(now())
    updatedAt        DateTime    @updatedAt

    @@map("quiz")
}

model Membro {
    id        Int      @id @default(autoincrement())
    nome      String
    curso     String
    funcao    String   
    sobre     String   @db.Text
    fotoUrl   String?  
    github    String?  
    linkedin  String?  
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("membro")
}